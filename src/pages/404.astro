---
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import { CATEGORIES } from '../utils/catalog';
---

<BaseLayout title="Page Not Found" description="That page does not exist on fasteners.fyi.">
  <div class="wrap pt-10 pb-4">
    <div class="grid gap-8 md:gap-12 md:grid-cols-[auto_minmax(0,1fr)] md:items-center max-w-[50rem]">
      <div class="picture w-fit">
        <div class="picture-stage !px-12 !min-h-0">
          <Figure category="bolts" slug="hex-bolt" variant="ghost" views="side" scale={0.2} />
        </div>
      </div>
      <div>
        <h1 class="text-[1.9rem] sm:text-[2.3rem] mb-3">Nothing here</h1>
        <p class="text-[0.98rem] text-ink-2 max-w-[30rem] mb-6">That address does not match any page on this site. It may have been renamed, or it may never have existed.</p>
        <form action="/search" method="get" role="search" class="flex gap-2 max-w-[26rem] mb-5">
          <input class="input" type="search" name="q" placeholder="lag bolt, drywall anchor, wing nut" aria-label="Search fasteners by name or use" />
          <button type="submit" class="btn btn-primary shrink-0">Search</button>
        </form>
        <ul class="flex flex-wrap gap-1.5">
          {CATEGORIES.map((c) => <li><a class="chip" href={`/${c.key}`}>{c.name} <span class="n">{c.items.length}</span></a></li>)}
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
