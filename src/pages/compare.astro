---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import Figure from '../components/Figure.astro';
import { CATEGORIES, label, sizeText } from '../utils/catalog';
import { PAIRS } from '../utils/copy';
import { canonicalFor } from '../utils/canonical';

// A fastener listed under two kinds is offered once, under its main one.
const all = CATEGORIES.flatMap((c) => c.items.filter((f) => !canonicalFor(c.key, f.slug)).map((f) => ({ c, f: f as typeof f & Record<string, any> })));

const list = (v: string[] | undefined, map: (s: string) => string = (s) => s) => (v?.length ? v.map(map).join(', ') : '');
const none = (v: string | undefined) => (v ? label(v) : '');

// Every row a comparison can show, in order. A row appears only when at least
// one of the selected fasteners has a value for it.
const ROWS = ['Type', 'What it is', 'Head', 'Drive', 'Thread', 'Point', 'Locking', 'Washer kind', 'Goes into', 'Diameter', 'Length', 'Hole', 'Outside diameter', 'Thickness', 'Holds, pulling out', 'Holds, sideways', 'Made of', 'Sizes made in', 'Standards', 'Used for', 'Not for', 'Also called'];

const data = all.map(({ c, f }) => ({
  slug: f.slug,
  name: f.name,
  href: `/${c.key}/${f.slug}`,
  group: c.one,
  cells: {
    Type: c.one,
    'What it is': f.description,
    Head: none(f.headStyle),
    Drive: none(f.driveType),
    Thread: none(f.threadType),
    Point: none(f.pointType),
    Locking: none(f.lockingMechanism),
    'Washer kind': none(f.washerType),
    'Goes into': list(f.baseMaterial, label),
    Diameter: sizeText(f.diameterRange, 'diameter'),
    Length: sizeText(f.lengthRange),
    Hole: sizeText(f.innerDiameterRange),
    'Outside diameter': sizeText(f.outerDiameterRange),
    Thickness: sizeText(f.thicknessRange, 'thickness'),
    'Holds, pulling out': f.loadCapacity?.tension ? `${f.loadCapacity.tension.toLocaleString('en-US')} ${f.loadCapacity.unit}` : '',
    'Holds, sideways': f.loadCapacity?.shear ? `${f.loadCapacity.shear.toLocaleString('en-US')} ${f.loadCapacity.unit}` : '',
    'Made of': list(f.materials, label),
    'Sizes made in': list(f.measurementSystem, (s) => (s === 'imperial' ? 'Inch' : label(s))),
    Standards: list(f.standards),
    'Used for': list(f.applications),
    'Not for': list(f.notRecommendedFor),
    'Also called': list(f.aliases),
  } as Record<string, string>,
}));

const nameOf = (slug: string) => all.find((x) => x.f.slug === slug)?.f.name ?? slug;
---

<BaseLayout title="Compare Fasteners" description="Put two or three screws, bolts, anchors, nuts or washers side by side and see where they differ.">
  <BreadcrumbSchema items={[{ label: 'Compare' }]} />
  <div class="wrap pt-5">
    <nav class="crumbs mb-5" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <span class="text-ink" aria-current="page">Compare</span>
    </nav>
    <h1 class="text-[1.9rem] sm:text-[2.3rem] mb-2">Compare</h1>
    <p class="text-[0.98rem] text-ink-2 mb-6 max-w-[38rem]">Pick two or three fasteners to see them side by side. Whatever is different between them is highlighted.</p>

    <div class="grid gap-3 md:grid-cols-3 mb-8">
      {[1, 2, 3].map((n) => (
        <label class="block">
          <span class="label block mb-1.5">Fastener {n}{n === 3 && ' (optional)'}</span>
          <select id={`select-${n}`} class="input">
            <option value="">Pick a fastener</option>
            {CATEGORIES.map((c) => (
              <optgroup label={c.name}>
                {all.filter((x) => x.c === c).sort((a, b) => a.f.name.localeCompare(b.f.name)).map((x) => <option value={x.f.slug}>{x.f.name}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
      ))}
    </div>

    <div id="comparison-table" hidden>
      <div class="table-scroll">
        <table class="table">
          <thead><tr id="table-header"></tr></thead>
          <tbody id="table-body"></tbody>
        </table>
      </div>
      <p class="text-[0.72rem] text-muted mt-2.5"><span class="inline-block w-3.5 h-3.5 align-[-0.15em] bg-accent-soft border border-line-2"></span> Highlighted rows are where they differ. The pictures share one thread size.</p>
    </div>

    <div id="empty-state" class="callout max-w-[38rem]">
      <p class="font-bold mb-1">Nothing picked yet</p>
      <p class="text-ink-2">Pick at least two fasteners above, or start from one of the pairs below.</p>
    </div>

    <section class="mt-12">
      <h2 class="section-title">Often mixed up</h2>
      <div class="facts sm:grid-cols-2 lg:grid-cols-3">
        {PAIRS.map(([a, b]) => (
          <a href={`/compare?a=${a}&b=${b}`} class="fact text-[0.84rem]">
            <span class="font-bold">{nameOf(a)}</span> or <span class="font-bold">{nameOf(b)}</span>?
          </a>
        ))}
      </div>
    </section>

    <!-- Pictures for the column heads, cloned in by the script below. -->
    <div hidden id="figure-pool">
      {all.map(({ c, f }) => <div data-fig={f.slug}><Figure category={c.key} slug={f.slug} variant="card" scale={0.1} /></div>)}
    </div>
  </div>

  <script define:vars={{ data, ROWS }}>
    const bySlug = new Map(data.map((f) => [f.slug, f]));
    const selects = [1, 2, 3].map((n) => document.getElementById('select-' + n));
    const table = document.getElementById('comparison-table');
    const empty = document.getElementById('empty-state');
    const header = document.getElementById('table-header');
    const body = document.getElementById('table-body');
    const pool = document.getElementById('figure-pool');

    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function render() {
      const picked = selects.map((s) => bySlug.get(s.value)).filter(Boolean);
      const ready = picked.length >= 2;
      table.hidden = !ready;
      empty.hidden = ready;

      const url = new URL(window.location);
      ['a', 'b', 'c'].forEach((k, i) => {
        if (selects[i].value) url.searchParams.set(k, selects[i].value);
        else url.searchParams.delete(k);
      });
      window.history.replaceState({}, '', url);
      if (!ready) return;

      // The pictures stand on one strip of paper that runs across the columns;
      // each name sits under its own, off the paper.
      header.replaceChildren(el('td', '!bg-surface !border-b-2 !border-b-ink', ''));
      for (const f of picked) {
        const th = el('th', '!align-bottom !whitespace-normal !bg-surface !p-0');
        const fig = pool.querySelector('[data-fig="' + f.slug + '"] svg');
        if (fig) {
          const box = el('div', 'flex items-end justify-center h-[10.6rem] px-[0.7rem] pt-[0.55rem] pb-2 bg-stage');
          box.append(fig.cloneNode(true));
          th.append(box);
        }
        const name = el('div', 'px-[0.7rem] pt-2 pb-[0.55rem]');
        const a = el('a', 'link block text-[0.86rem]', f.name);
        a.href = f.href;
        name.append(a, el('span', 'label block mt-0.5', f.group));
        th.append(name);
        header.append(th);
      }

      body.replaceChildren();
      for (const row of ROWS) {
        const values = picked.map((f) => f.cells[row] || '');
        if (!values.some(Boolean)) continue;
        const differs = new Set(values).size > 1 && row !== 'What it is';
        const tr = el('tr');
        const th = el('th', 'whitespace-nowrap', row);
        th.scope = 'row';
        tr.append(th);
        for (const v of values) tr.append(el('td', (differs ? 'diff ' : '') + (row === 'What it is' ? 'min-w-[13rem]' : ''), v || '–'));
        body.append(tr);
      }
    }

    const params = new URLSearchParams(window.location.search);
    ['a', 'b', 'c'].forEach((k, i) => {
      const v = params.get(k);
      if (v && bySlug.has(v)) selects[i].value = v;
    });
    selects.forEach((s) => s.addEventListener('change', render));
    render();
  </script>
</BaseLayout>
