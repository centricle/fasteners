---
import FastenerPage from '../../components/FastenerPage.astro';
import { category } from '../../utils/catalog';
import type { Fastener } from '../../types/fastener';

export function getStaticPaths() {
  return category('anchors').items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
  item: Fastener;
}
---

<FastenerPage category="anchors" item={Astro.props.item} />
