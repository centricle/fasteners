---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../components/BreadcrumbSchema.astro';
import Figure from '../components/Figure.astro';
import { CATEGORIES, TOTAL, haystack } from '../utils/catalog';

// Every entry is in the page, so the list works as a full index without
// scripting and the filter below never waits on a request.
const all = CATEGORIES.flatMap((c) => c.items.map((f) => ({ c, f })));
const tries = ['wood', 'drywall', 'concrete', 'lock', 'hex', 'stainless', 'outdoor'];
---

<BaseLayout title="Search Fasteners" description="Search every screw, bolt, nut, washer and anchor by name, material or what it is used for.">
  <BreadcrumbSchema items={[{ label: 'Search' }]} />
  <div class="wrap pt-5">
    <nav class="crumbs mb-5" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">/</span> <span class="text-ink" aria-current="page">Search</span>
    </nav>
    <h1 class="text-[1.9rem] sm:text-[2.3rem] mb-4">Search</h1>

    <form id="search-form" method="get" action="/search" role="search" class="max-w-[36rem]">
      <input type="search" name="q" id="search-input" class="input" autocomplete="off" spellcheck="false" placeholder="A name, a material, or what it is for" aria-label="Search fasteners" />
    </form>
    <div class="flex flex-wrap items-center gap-1.5 mt-3">
      <span class="label mr-1">Try</span>
      {tries.map((t) => <button type="button" class="chip cursor-pointer" data-try={t}>{t}</button>)}
    </div>

    <p id="search-status" class="label mt-8 mb-2" aria-live="polite">{TOTAL} fasteners</p>
    <div class="rows" id="results">
      {all.map(({ c, f }) => (
        <a class="row" href={`/${c.key}/${f.slug}`} data-hay={haystack(f)}>
          <span class="pic"><Figure category={c.key} slug={f.slug} variant="mini" scale={0.055} /></span>
          <span class="min-w-0">
            <span class="n block" data-text={f.name}>{f.name}</span>
            <span class="d block" data-text={f.description}>{f.description}</span>
          </span>
          <span class="tag hidden sm:inline-flex">{c.one}</span>
        </a>
      ))}
    </div>

    <div id="no-results" class="callout max-w-[36rem]" hidden>
      <p class="font-bold mb-1">Nothing matches "<span id="no-results-query"></span>".</p>
      <p class="text-ink-2">Search looks at names, other names a fastener goes by, materials, uses and standard numbers. Try a shorter word, or pick a kind of fastener from the menu.</p>
    </div>
  </div>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement;
    const form = document.getElementById('search-form') as HTMLFormElement;
    const status = document.getElementById('search-status')!;
    const empty = document.getElementById('no-results')!;
    const emptyQuery = document.getElementById('no-results-query')!;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#results .row'));
    const total = rows.length;

    // Rebuild a text node with the matches wrapped, without touching innerHTML.
    function mark(el: HTMLElement, re: RegExp | null) {
      const text = el.dataset.text ?? '';
      el.textContent = '';
      if (!re) {
        el.textContent = text;
        return;
      }
      let last = 0;
      for (const m of text.matchAll(re)) {
        const at = m.index ?? 0;
        el.append(text.slice(last, at));
        const k = document.createElement('mark');
        k.textContent = m[0];
        el.append(k);
        last = at + m[0].length;
      }
      el.append(text.slice(last));
    }

    function run(push = true) {
      const q = input.value.trim();
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      const re = terms.length ? new RegExp(terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|'), 'gi') : null;
      let shown = 0;
      for (const row of rows) {
        const hit = terms.every((t) => row.dataset.hay!.includes(t));
        row.hidden = !hit;
        if (hit) {
          shown++;
          row.querySelectorAll<HTMLElement>('[data-text]').forEach((el) => mark(el, re));
        }
      }
      status.textContent = q ? `${shown} result${shown === 1 ? '' : 's'} for "${q}"` : `${total} fasteners`;
      empty.hidden = shown > 0;
      emptyQuery.textContent = q;
      if (push) {
        const url = new URL(location.href);
        if (q) url.searchParams.set('q', q);
        else url.searchParams.delete('q');
        history.replaceState({}, '', url);
      }
    }

    input.value = new URLSearchParams(location.search).get('q') ?? '';
    run(false);
    input.addEventListener('input', () => run());
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run();
    });
    document.querySelectorAll<HTMLElement>('[data-try]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.try ?? '';
        run();
        input.focus();
      }),
    );
    if (!input.value && matchMedia('(pointer: fine)').matches) input.focus();
  </script>
</BaseLayout>
