---
// Renders one generated picture (src/lib/figure) as inline SVG.
//
//   full   both views, with each measurement marked and named in a word
//          ("Length", "Diameter"). The words are HTML laid over the SVG so
//          they stay one size while the picture scales.
//   card   the catalog size: both views, no measurements.
//   mini   one view, outline and fill only, for lists and table rows.
//   ghost  a dashed outline, for a part that is not there.
//
// `scale` is rem per drawing unit. Every figure is drawn around a 10-unit
// thread, so figures at one scale are in proportion to each other.
//
// A figure also describes center lines and hidden edges. They are not drawn:
// they are how a drafter reads a part, and the person looking one up wants to
// see the part.
import { f, type Kind, type Pt } from '../lib/figure/core';
import { figure } from '../lib/figure';

interface Props {
  category: string;
  slug: string;
  variant?: 'full' | 'card' | 'mini' | 'ghost';
  /** `side` drops the second view. */
  views?: 'both' | 'side';
  scale?: number;
  /** Accessible name. Omit where adjacent text already names the part. */
  label?: string;
  /** The word for each measurement on the full picture, by key: { L: 'Length' }. */
  words?: Record<string, string>;
  class?: string;
}

const { category, slug, variant = 'card', views = 'both', label, words = {}, class: cls } = Astro.props;
const scale = Astro.props.scale ?? { full: 0.25, card: 0.115, mini: 0.07, ghost: 0.23 }[variant];

// Screws, bolts and anchors are known by their profile, so the small size shows
// only that. Nuts and washers are known from above, so they keep both views.
const flat = /^(nut|washer)/.test(category);
const fig = figure(category, slug, { top: views !== 'side' && (variant !== 'mini' || flat) });

const SKIP: Kind[] = ['ctr', 'hid'];
const MINI: Kind[] = ['body', 'soft', 'ink', 'edge'];
const outline = variant === 'mini' || variant === 'ghost';
const items = fig ? fig.items.filter((i) => (outline ? MINI.includes(i.k) : !SKIP.includes(i.k))) : [];

// Measurements: extension lines, a line with arrowheads, and the word.
const AR = 2.5;
const AW = 0.7;
// The word is set in rem and the picture in units, so its footprint in units
// depends on the scale. 0.62rem type, about 0.58em a letter, plus padding.
const EM = 0.62 / scale;
const wide = (s: string) => (s.length * 0.58 + 1.3) * EM;

let x0 = fig?.x0 ?? 0;
let y0 = fig?.y0 ?? 0;
let x1 = fig?.x1 ?? 0;
let y1 = fig?.y1 ?? 0;
let lines = '';
let arrows = '';
const tags: { word: string; x: number; y: number }[] = [];

const seg = (a: Pt, b: Pt) => `M${f(a[0])} ${f(a[1])}L${f(b[0])} ${f(b[1])}`;
const tri = (tip: Pt, dx: number, dy: number) => {
  // An arrowhead at `tip` whose barbs trail back along (dx, dy).
  const bx = tip[0] + dx * AR;
  const by = tip[1] + dy * AR;
  return `M${f(tip[0])} ${f(tip[1])}L${f(bx - dy * AW)} ${f(by + dx * AW)} ${f(bx + dy * AW)} ${f(by - dx * AW)}Z`;
};

if (fig && variant === 'full') {
  const bx0 = fig.x0;
  const by0 = fig.y0;
  const bx1 = fig.x1;
  const by1 = fig.y1;
  for (const d of fig.dims) {
    const word = words[d.key] ?? d.key;
    const vertical = d.side === 'l' || d.side === 'r';
    const out = d.side === 'r' || d.side === 'b' ? 1 : -1;
    const ua = vertical ? d.a[1] : d.a[0];
    const ub = vertical ? d.b[1] : d.b[0];
    const lo = Math.min(ua, ub);
    const hi = Math.max(ua, ub);
    const tight = hi - lo < 7.5;
    const w = wide(word);
    // A word that sits on a vertical line reaches back toward the part by
    // half its width, so the line stands off at least that far.
    const off = vertical && !tight ? Math.max(d.off, w / 2 + 1.4) : d.off;
    // `at` is where the measuring line sits; u runs along it.
    const at = d.side === 'r' ? bx1 + off : d.side === 'l' ? bx0 - off : d.side === 'b' ? by1 + off : by0 - off;
    const P = (u: number, v: number): Pt => (vertical ? [v, u] : [u, v]);
    for (const p of [d.a, d.b]) {
      const from = (vertical ? p[0] : p[1]) + 1.1 * out;
      const u = vertical ? p[1] : p[0];
      if ((at - from) * out > 0) lines += seg(P(u, from), P(u, at + 1.3 * out));
    }
    const [ux, uy] = vertical ? [0, 1] : [1, 0];
    if (tight) {
      // No room between the extension lines: arrows come in from outside.
      lines += seg(P(lo - 4.4, at), P(hi + 4.4, at));
      arrows += tri(P(lo, at), -ux, -uy) + tri(P(hi, at), ux, uy);
    } else {
      lines += seg(P(lo, at), P(hi, at));
      arrows += tri(P(lo, at), ux, uy) + tri(P(hi, at), -ux, -uy);
    }

    // Where the word goes. Along a vertical line it sits on the line, which
    // it covers; on a short one it goes past the far arrow instead. Along a
    // horizontal line it sits just outside, centered on what is measured.
    const mid = (lo + hi) / 2;
    let kx: number;
    let ky: number;
    if (vertical) {
      kx = at;
      ky = tight ? hi + 4.4 + EM * 1.1 : mid;
    } else {
      kx = mid;
      ky = at + out * EM * 1.25;
    }
    tags.push({ word, x: kx, y: ky });
    const reach: Pt[] = [
      [kx - w / 2, ky - EM * 0.9],
      [kx + w / 2, ky + EM * 0.9],
      P(lo - (tight ? 4.4 : 0), at - 1.3),
      P(hi + (tight ? 4.4 : 0), at + 1.3),
    ];
    for (const [px, py] of reach) {
      x0 = Math.min(x0, px);
      x1 = Math.max(x1, px);
      y0 = Math.min(y0, py);
      y1 = Math.max(y1, py);
    }
  }
}

const pad = 1.6;

// Measurements usually hang off one side, which pushes the part off center
// in its card. Pad the other side to match, as long as the picture still fits
// a phone at full size (wider ones are left alone and scale down instead).
if (fig && variant === 'full') {
  const cx = (fig.x0 + fig.x1) / 2;
  const half = Math.max(cx - x0, x1 - cx);
  if ((half + pad) * 2 * scale <= 14.5) {
    x0 = cx - half;
    x1 = cx + half;
  }
}

const vx = x0 - pad;
const vy = y0 - pad;
const vw = x1 - x0 + pad * 2;
const vh = y1 - y0 + pad * 2;
const viewBox = `${f(vx)} ${f(vy)} ${f(vw)} ${f(vh)}`;
const width = `${f(vw * scale)}rem`;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

{fig && variant === 'full' ? (
  <div class:list={['figure', cls]} style={`width:${width}`}>
    <svg class="fig fig--full" viewBox={viewBox} {...a11y}>
      {items.map((i) => <path class={`f-${i.k}`} d={i.d} />)}
      {lines && <path class="f-dim" d={lines} />}
      {arrows && <path class="f-arrow" d={arrows} />}
    </svg>
    {tags.map((t) => (
      <span class="dimword" aria-hidden="true" style={`left:${f(((t.x - vx) / vw) * 100)}%;top:${f(((t.y - vy) / vh) * 100)}%`}>{t.word}</span>
    ))}
  </div>
) : fig ? (
  <svg class:list={['fig', `fig--${variant}`, cls]} viewBox={viewBox} style={`width:${width}`} {...a11y}>
    {items.map((i) => <path class={`f-${i.k}`} d={i.d} />)}
  </svg>
) : null}
